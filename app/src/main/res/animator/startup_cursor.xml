<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1060" android:repeatCount="infinite">
    <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0.85" />
        <keyframe android:fraction="0.499" android:value="0.85" />
        <keyframe android:fraction="0.5" android:value="0" />
        <keyframe android:fraction="1" android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
